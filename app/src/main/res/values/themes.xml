<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.InventoryManager" parent="Theme.Material3.DayNight">
        <item name="android:windowBackground">@color/cream</item>
        <item name="colorButtonNormal">@color/green_light3</item>
        <item name="android:navigationBarColor">@color/green_light1</item>
        <item name="colorPrimary">@color/green_dark4</item>
        <item name="colorPrimaryDark">@color/green_dark4</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:actionBarStyle">@style/MyActionBar</item>
    </style>

    <!-- Action Bar Style -->
    <style name="MyActionBar" parent="@style/Widget.AppCompat.ActionBar">
        <item name="android:background">@color/green_dark4</item>
        <item name="android:titleTextStyle">@style/MyActionBarTitleText</item>
    </style>

    <!-- Action Bar Title Text Style -->
    <style name="MyActionBarTitleText"
        parent="@style/TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/black</item>
    </style>
</resources>